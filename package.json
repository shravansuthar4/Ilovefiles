{
  "name": "i-love-files",
  "productName": "I love files",
  "version": "1.0.0",
  "description": "Drag any file, press C, and drop it on a format to convert it",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test/convert.test.js",
    "setup": "node scripts/fetch-binaries.js",
    "guide": "electron scripts/make-guide.js",
    "release": "node scripts/fetch-binaries.js && node scripts/build.js && electron scripts/make-guide.js"
  },
  "keywords": [
    "file-converter",
    "electron",
    "drag-and-drop",
    "macos",
    "windows",
    "ffmpeg",
    "image-converter"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "sharp": "^0.35.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ilovefiles.app",
    "productName": "I love files",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/uiohook-napi/**"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "I love files"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "I love files"
    }
  },
  "private": true
}
